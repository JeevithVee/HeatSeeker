{
  "name": "heatseeker-load-silver",
  "description": "Publishes silver.interventions and silver.features for all cities from the checksummed per-city tables on branch agent-1-data.",
  "git_source": {
    "git_url": "https://github.com/JeevithVee/HeatSeeker",
    "git_provider": "gitHub",
    "git_branch": "agent-1-data"
  },
  "tags": {"project": "heatseeker", "component": "silver_features_interventions"},
  "environments": [
    {
      "environment_key": "default",
      "spec": {"environment_version": "4", "dependencies": ["pandas", "pyyaml"]}
    }
  ],
  "parameters": [{"name": "catalog", "default": "heatseeker"}],
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "load_silver",
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/load_silver.py",
        "source": "GIT",
        "parameters": ["--catalog", "{{job.parameters.catalog}}"]
      },
      "timeout_seconds": 1800
    }
  ]
}
