{
  "name": "heatseeker-site-effects",
  "description": "Verified per-city surface-temperature evaluation. Runs tests, then NYC/DC/SEA/SF sequentially; reads pinned silver Delta snapshots or checksum-verified owner-provided Volume files.",
  "git_source": {
    "git_url": "https://github.com/JeevithVee/HeatSeeker",
    "git_provider": "gitHub",
    "git_branch": "agent-3-eval"
  },
  "tags": {
    "project": "heatseeker",
    "component": "site_effects"
  },
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "environment_version": "4",
        "dependencies": [
          "numpy==2.1.3",
          "pandas==2.2.3",
          "pyarrow==19.0.1",
          "pytest==8.3.5"
        ]
      }
    }
  ],
  "parameters": [
    {
      "name": "catalog",
      "default": "heatseeker"
    },
    {
      "name": "n_bootstrap",
      "default": "500"
    },
    {
      "name": "n_placebo",
      "default": "800"
    },
    {
      "name": "input_dir",
      "default": ""
    },
    {
      "name": "output_dir",
      "default": "/Volumes/heatseeker/gold/files/site_effects/runs"
    },
    {
      "name": "sensors",
      "default": "LANDSAT_8 LANDSAT_9"
    },
    {
      "name": "publish_gold",
      "default": "true"
    },
    {
      "name": "panel_source",
      "default": "files"
    }
  ],
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "evaluation_tests",
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/site_effects/run_tests.py",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "evaluate_nyc",
      "depends_on": [
        {
          "task_key": "evaluation_tests"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/site_effects/run_site_effects.py",
        "source": "GIT",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--city-id",
          "nyc",
          "--n-bootstrap",
          "{{job.parameters.n_bootstrap}}",
          "--n-placebo",
          "{{job.parameters.n_placebo}}",
          "--input-dir",
          "{{job.parameters.input_dir}}",
          "--output-dir",
          "{{job.parameters.output_dir}}/{{job.run_id}}",
          "--sensors",
          "{{job.parameters.sensors}}",
          "--publish-gold",
          "{{job.parameters.publish_gold}}",
          "--panel-source",
          "{{job.parameters.panel_source}}"
        ]
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "evaluate_dc",
      "depends_on": [
        {
          "task_key": "evaluate_nyc"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/site_effects/run_site_effects.py",
        "source": "GIT",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--city-id",
          "dc",
          "--n-bootstrap",
          "{{job.parameters.n_bootstrap}}",
          "--n-placebo",
          "{{job.parameters.n_placebo}}",
          "--input-dir",
          "{{job.parameters.input_dir}}",
          "--output-dir",
          "{{job.parameters.output_dir}}/{{job.run_id}}",
          "--sensors",
          "{{job.parameters.sensors}}",
          "--publish-gold",
          "{{job.parameters.publish_gold}}",
          "--panel-source",
          "{{job.parameters.panel_source}}"
        ]
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "evaluate_sea",
      "depends_on": [
        {
          "task_key": "evaluate_dc"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/site_effects/run_site_effects.py",
        "source": "GIT",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--city-id",
          "sea",
          "--n-bootstrap",
          "{{job.parameters.n_bootstrap}}",
          "--n-placebo",
          "{{job.parameters.n_placebo}}",
          "--input-dir",
          "{{job.parameters.input_dir}}",
          "--output-dir",
          "{{job.parameters.output_dir}}/{{job.run_id}}",
          "--sensors",
          "{{job.parameters.sensors}}",
          "--publish-gold",
          "{{job.parameters.publish_gold}}",
          "--panel-source",
          "{{job.parameters.panel_source}}"
        ]
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "evaluate_sf",
      "depends_on": [
        {
          "task_key": "evaluate_sea"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "pipelines/site_effects/run_site_effects.py",
        "source": "GIT",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--city-id",
          "sf",
          "--n-bootstrap",
          "{{job.parameters.n_bootstrap}}",
          "--n-placebo",
          "{{job.parameters.n_placebo}}",
          "--input-dir",
          "{{job.parameters.input_dir}}",
          "--output-dir",
          "{{job.parameters.output_dir}}/{{job.run_id}}",
          "--sensors",
          "{{job.parameters.sensors}}",
          "--publish-gold",
          "{{job.parameters.publish_gold}}",
          "--panel-source",
          "{{job.parameters.panel_source}}"
        ]
      },
      "timeout_seconds": 3600
    }
  ]
}
